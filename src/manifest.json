{
  "manifest_version": 3,
  "name": "QRCoder",
  "icons": { "128": "icon.png" },
  "version": "1.0.0",
  "description": "在本地生成和识别二维码。",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "offscreen", "storage", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "QRCoder", "default_icon": { "128": "icon.png" }, "default_popup": "popup.html" }
}
